@@ -0,0 +1,156 @@
+//! Minimal C-ABI entry point for driving the language server from JS in a
+//! browser/worker. No threads, no stdio: JS pushes JSON-RPC messages in and
+//! pulls them out, and `ela_pump` drives the (current-thread) tokio runtime a
+//! bounded number of steps per call.
+use std::cell::RefCell;
+use std::future::Future;
+use std::pin::Pin;
+
+use lsp_server::{Connection, Message};
+use lsp_types::InitializeParams;
+
+use crate::cmd_args::{CmdArgs, CmdBool, Communication, LogLevel, NoneableString};
+use crate::handlers::server_capabilities;
+use crate::server::AsyncConnection;
+use crate::server::main_loop::main_loop;
+
+struct State {
+    rt: tokio::runtime::Runtime,
+    client: Connection,
+    fut: Option<Pin<Box<dyn Future<Output = ()>>>>,
+}
+
+thread_local! {
+    static STATE: RefCell<Option<State>> = RefCell::new(None);
+}
+
+fn cmd_args() -> CmdArgs {
+    CmdArgs {
+        communication: Communication::Stdio,
+        ip: "127.0.0.1".into(),
+        port: 0,
+        log_level: LogLevel::Info,
+        log_path: NoneableString(None),
+        resources_path: NoneableString(None),
+        load_stdlib: CmdBool(true),
+        editor: None,
+    }
+}
+
+/// Boot: answer `initialize` off the channel ourselves (the stock path uses a
+/// blocking stdio read), then hand over to the stock main loop.
+async fn boot(server: Connection) {
+    let mut conn = AsyncConnection::from_sync(server);
+    let (id, params) = loop {
+        match conn.recv().await {
+            Some(Message::Request(req)) if req.method == "initialize" => break (req.id, req.params),
+            Some(_) => continue,
+            None => return,
+        }
+    };
+    let params: InitializeParams = serde_json::from_value(params).unwrap();
+    let caps = server_capabilities(&params.capabilities);
+    let result = serde_json::json!({
+        "capabilities": caps,
+        "serverInfo": { "name": "emmylua_ls", "version": env!("CARGO_PKG_VERSION") }
+    });
+    let _ = conn.send(lsp_server::Response::new_ok(id, result).into());
+    let _ = main_loop(conn, params, cmd_args()).await;
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn ela_alloc(len: usize) -> *mut u8 {
+    let mut v = vec![0u8; len];
+    let p = v.as_mut_ptr();
+    std::mem::forget(v);
+    p
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn ela_start() {
+    let rt = tokio::runtime::Builder::new_current_thread()
+        .enable_time()
+        .build()
+        .unwrap();
+    let (server, client) = Connection::memory();
+    let fut: Pin<Box<dyn Future<Output = ()>>> = Box::pin(boot(server));
+    STATE.with(|s| {
+        *s.borrow_mut() = Some(State {
+            rt,
+            client,
+            fut: Some(fut),
+        })
+    });
+}
+
+/// Push one JSON-RPC message (JSON text) into the server.
+#[unsafe(no_mangle)]
+pub extern "C" fn ela_push(ptr: *mut u8, len: usize) {
+    let bytes = unsafe { Vec::from_raw_parts(ptr, len, len) };
+    let Ok(msg) = serde_json::from_slice::<Message>(&bytes) else {
+        return;
+    };
+    STATE.with(|s| {
+        if let Some(st) = s.borrow().as_ref() {
+            let _ = st.client.sender.send(msg);
+        }
+    });
+}
+
+/// Drive the runtime for up to `steps` cooperative yields.
+#[unsafe(no_mangle)]
+pub extern "C" fn ela_pump(steps: u32) {
+    STATE.with(|s| {
+        let mut b = s.borrow_mut();
+        let Some(st) = b.as_mut() else { return };
+        let Some(mut fut) = st.fut.take() else { return };
+        let done = st.rt.block_on(async {
+            for _ in 0..steps {
+                if poll_once(fut.as_mut()).is_some() {
+                    return true;
+                }
+                tokio::task::yield_now().await;
+            }
+            false
+        });
+        if !done {
+            st.fut = Some(fut);
+        }
+    });
+}
+
+fn poll_once<F: Future + ?Sized>(mut fut: Pin<&mut F>) -> Option<F::Output> {
+    use std::task::{Context, Poll, RawWaker, RawWakerVTable, Waker};
+    // ponytail: no-op waker; `ela_pump` polls on a fixed schedule anyway.
+    const VTABLE: RawWakerVTable = RawWakerVTable::new(
+        |_| RawWaker::new(std::ptr::null(), &VTABLE),
+        |_| {},
+        |_| {},
+        |_| {},
+    );
+    let waker = unsafe { Waker::from_raw(RawWaker::new(std::ptr::null(), &VTABLE)) };
+    match fut.as_mut().poll(&mut Context::from_waker(&waker)) {
+        Poll::Ready(v) => Some(v),
+        Poll::Pending => None,
+    }
+}
+
+/// Take the next outgoing message, as a length-prefixed (u32 LE) buffer, or null.
+#[unsafe(no_mangle)]
+pub extern "C" fn ela_take() -> *mut u8 {
+    STATE.with(|s| {
+        let b = s.borrow();
+        let Some(st) = b.as_ref() else {
+            return std::ptr::null_mut();
+        };
+        let Ok(msg) = st.client.receiver.try_recv() else {
+            return std::ptr::null_mut();
+        };
+        let json = serde_json::to_vec(&msg).unwrap_or_default();
+        let mut out = (json.len() as u32).to_le_bytes().to_vec();
+        out.extend_from_slice(&json);
+        let p = out.as_mut_ptr();
+        std::mem::forget(out);
+        p
+    })
+}
